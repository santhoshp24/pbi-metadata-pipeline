            {
              "name": "Vessel_Calls",
              "columns": [
                {
                  "name": "VesselKey",
                  "dataType": "int64",
                  "sourceColumn": "VesselKey"
                },
                {
                  "name": "PortKey",
                  "dataType": "int64",
                  "sourceColumn": "PortKey"
                },
                {
                  "name": "ArrivalDate",
                  "dataType": "dateTime",
                  "sourceColumn": "ArrivalDate"
                },
                {
                  "name": "ArrivalTime",
                  "dataType": "dateTime",
                  "sourceColumn": "ArrivalTime"
                },
                {
                  "name": "DepartureTime",
                  "dataType": "dateTime",
                  "sourceColumn": "DepartureTime"
                },
                {
                  "name": "IsOnTime",
                  "dataType": "boolean",
                  "sourceColumn": "IsOnTime"
                }
              ],
              "measures": [
                {
                  "name": "Total Calls",
                  "expression": "COUNTROWS(Vessel_Calls)",
                  "format": "#,0",
                  "displayFolder": null
                },
                {
                  "name": "Avg Turnaround (hrs)",
                  "expression": "AVERAGEX(\nVessel_Calls,\nDATEDIFF(Vessel_Calls[ArrivalTime], Vessel_Calls[DepartureTime], HOUR)\n)",
                  "format": "0.0",
                  "displayFolder": null
                },
                {
                  "name": "On-Time Arrival %",
                  "expression": "DIVIDE(\nCALCULATE(COUNTROWS(Vessel_Calls), Vessel_Calls[IsOnTime] = TRUE()),\n[Total Calls]\n)",
                  "format": "0.0%",
                  "displayFolder": null
                },
                {
                  "name": "Calls LY",
                  "expression": "CALCULATE([Total Calls], SAMEPERIODLASTYEAR(Dim_Date[Date]))",
                  "format": null,
                  "displayFolder": null
                }
              ],
              "partitions": [
                {
                  "name": "Vessel_Calls",
                  "type": "m",
                  "mode": "import",
                  "source": "let\nSource = Snowflake.Databases(\"demo-account.snowflakecomputing.com\", \"DEMO_WH\"),\nDb = Source{[Name=\"DEMO_MARITIME\", Kind=\"Database\"]}[Data],\nSch = Db{[Name=\"CURATED\", Kind=\"Schema\"]}[Data],\nTbl = Sch{[Name=\"FACT_VESSEL_CALLS\", Kind=\"Table\"]}[Data]\nin\nTbl"
                }
              ],
              "properties": {},
              "sources": [
                {
                  "type": "Snowflake",
                  "server": "demo-account.snowflakecomputing.com",
                  "database": "DEMO_MARITIME",
                  "schema": "CURATED",
                  "table": "FACT_VESSEL_CALLS"
                }
              ]
            },
            {
              "name": "_Measures",
              "columns": [],
              "measures": [
                {
                  "name": "Calls YoY %",
                  "expression": "DIVIDE([Total Calls] - [Calls LY], [Calls LY])",
                  "format": "0.0%",
                  "displayFolder": null
                },
                {
                  "name": "Berth Utilisation %",
                  "expression": "VAR _used = SUM(Dim_Port[OccupiedHours])\nVAR _avail = SUM(Dim_Port[AvailableHours])\nRETURN DIVIDE(_used, _avail)",
                  "format": "0.0%",
                  "displayFolder": null
                }
              ],
              "partitions": [
                {
                  "name": "_Measures",
                  "type": "m",
                  "mode": "import",
                  "source": "#table({\"x\"}, {})"
                }
              ],
              "properties": {},
              "sources": []
            }
